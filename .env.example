# Copy this file to .env and fill in real values before deploying.

# --- Database (Postgres) ---
# Vercel's Postgres/Neon integration (Storage tab -> Create Database ->
# Postgres) auto-populates this in your Vercel project's env vars once
# attached — you normally don't set it by hand in production. For local
# dev/testing, point it at a local Postgres instance or a free Neon project,
# e.g.: postgres://user:password@localhost:5432/capacity_planner
DATABASE_URL=postgres://user:password@localhost:5432/capacity_planner
# Some Vercel Postgres integrations name the injected var POSTGRES_URL
# instead of DATABASE_URL — the app checks both, preferring DATABASE_URL if
# both are set. You don't need to set this yourself; it's here for reference.
# POSTGRES_URL=

# Required in production — any long random string. Sessions are signed with this.
SESSION_SECRET=replace-with-a-long-random-string

# Which email domain is allowed to register/log in.
ALLOWED_EMAIL_DOMAIN=hgs.com

# Port the server listens on.
PORT=3000

# Set to "production" when deploying behind HTTPS — this makes session
# cookies "secure" (HTTPS-only). Leave unset for local http:// testing.
NODE_ENV=production

# --- Email (SMTP) ---
# If SMTP_HOST is left unset, the app runs in DEV MODE: verification and
# password-reset emails are logged to the console and data/mail-outbox.log
# instead of actually being sent, and the relevant API responses include a
# devVerifyUrl/devResetUrl field so the login screen can show it directly.
# This is fine for local testing but NOT for real users — set these before
# giving this app to real people:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HGS AgentX Capacity Planner <no-reply@hgs.com>"
